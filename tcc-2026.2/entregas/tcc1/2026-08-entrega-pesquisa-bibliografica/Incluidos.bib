@inproceedings{sriharshaTaskAdaptiveLLMRouting2026,
	title = {Task-{Adaptive} {LLM} {Routing} {Architecture} for {Multi}-{Modal} {Educational} {Knowledge} {Retrieval} {Agents}},
	isbn = {979-833154823-0 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105045468690?origin=resultslist},
	doi = {10.1109/ICIETSD68684.2026.11584724},
	abstract = {Undergraduate engineering students frequently encounter challenges in accessing real-time, domain-specific academic support. While Large Language Models (LLMs) offer potential solutions, generic implementations often lack multimodal capabilities (processing text, audio, and visual data) and fail to provide reliable, hallucination-free guidance in specialized fields such as Information Security. This paper proposes 'Karn,' a multimodal conversational agent integrated into Telegram. The system utilizes an intelligent model-routing architecture to optimize inference latency and accuracy by selecting appropriate specialized models for distinct query types. To address the reliability issues common in generative models, Karn employs a dual-mode architecture: a dynamic Retrieval-Augmented Generation (RAG) layer powered by MongoDB Atlas Vector Search for user-uploaded documents and a static, zero-latency command-triggered layer (e.g., /wiki) for authoritative, hardcoded Information Security resources. This bifurcated approach guarantees hallucination-free retrieval for core study materials while maintaining adaptive reasoning for dynamic inputs. We conducted a performance analysis focusing on three key indicators: system latency, response precision, and the architecture's ability to scale under load. Our findings confirm that by embedding this tool within a familiar interface, we can provide immediate, context-sensitive academic support without the friction of traditional web platforms. © 2026 IEEE.},
	language = {English},
	booktitle = {Int. {Conf}. {Innov}. {Emerg}. {Technol}. {Sustain}. {Dev}.: {Empower}. {Innov}. {Sustain}. {Future}, {ICIETSD} - {Conf}. {Proc}.},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Sriharsha, A.V. and Vardhan, H. and Praneeta, P. and Rao, G.N. and Reddy, B.J.N.M.},
	year = {2026},
	note = {Journal Abbreviation: Int. Conf. Innov. Emerg. Technol. Sustain. Dev.: Empower. Innov. Sustain. Future, ICIETSD - Conf. Proc.},
	keywords = {Architecture, Large language model, Agents, Search engines, Large Language Models (LLMs), Intelligent agents, Language model, Multi agent systems, Information retrieval, Conversational agents, Learning systems, Students, Security of data, Memory architecture, Education computing, Multi-modal, Information management, Dynamic large language model routing, Dynamic LLM Routing, Information security education, Information Security Education, Knowledge Management, Multi-modal conversational agent, Multi-Modal Conversational Agents, Retrievalaugmented generation, RetrievalAugmented Generation (RAG), Routing algorithms, Routings, Telegram bot, Telegram Bot, Text processing, Vector search, Vector Search, incluido},
