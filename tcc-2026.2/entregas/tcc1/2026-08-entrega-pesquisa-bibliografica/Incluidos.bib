@inproceedings{bangunMultiAgentConversationalSystem2025,
	title = {Multi-{Agent} {Conversational} {System} for {Automated} {Stock} {Market} {Analysis} and {Decision} {Support} {Toward} {Inclusive} {Economic} {Growth}},
	isbn = {979-833158679-9 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105031903738?origin=resultslist},
	doi = {10.1109/ICoAIT67446.2025.11308989},
	abstract = {This research explores how to support investors in processing large amounts of real-time stock data for better decision-making. The paper introduces a Multi-Agent System that uses Large Language Models and the CrewAI framework to support more accurate stock prediction. The system uses an Intent Agent to classify queries and specialized agents for fundamental, technical, and macroeconomic analysis via APIs. Specifically, fundamental and technical data are sourced from the Yahoo Finance (yFinance) API, while macroeconomic data is retrieved using the EconDB API. A Summarizer Agent combines the results into clear and concise insights, which are delivered through a chatbot interface built with Streamlit. This architecture supports real-time, interactive communication, making advanced stock analysis more approachable for retail investors. To quantitatively evaluate agent performance, we validated system-generated recommendations against actual market movements across multiple Indonesian stocks within 30-day intervals. Result show that the Fundamental Agent achieved 75\% directional accuracy, correctly identifying stock trends through indicators such as revenue growth, profit margin, and debt levels. The Technical Agent attained 50\% accuracy, capturing momentum through MACD, RSI, and price-volume dynamics. These findings highlight the superiority of fundamental analysis for short-term prediction, while also emphasizing the limitations of relying on a single analytical dimension. Both agents demonstrated the ability to generate explainable investment suggestions, and the combined multi-agent approach provides a flexible, transparent, and scalable platform for decision support in finance. It also supports SDG 8 by promoting inclusive financial access and channeling investment toward sectors that foster growth and decent work.  © 2025 IEEE.},
	language = {English},
