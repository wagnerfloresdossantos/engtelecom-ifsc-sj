	keywords = {Chatbots, Cognitive systems, Decision making, Human computer interaction, Intelligent agents, Language model, Multi agent, Multi agent systems, Information retrieval, User interfaces, Multi-agent large language model, trust, Trust, Information use, Interactive computer systems, multi-agent LLM, Decisions makings, human-AI decision-making, Human-AI decision-making, human-AI interaction, Human-AI interaction, information seeking, Information seeking, Mental model, mental models, Multi-agent chatbot, multi-agent chatbots, reliance, Reliance, Sense making, sensemaking, transparency, Transparency, Visibility, incluido},
