	annote = {Export Date: 31 August 2026; Cited By: 0; Correspondence Address: K.I. Roumeliotis; University of the Peloponnese, Department of Informatics and Telecommunications, Tripoli, 22131, Greece; email: k.roumeliotis@uop.gr},
