	note = {Journal Abbreviation: 2025 20th International Joint Symposium on Artificial Intelligence and Natural Language Processing (iSAI-NLP)},
	keywords = {Large language models, Measurement, Oral communication, Monitoring, Large Language Models, Testing, Standards, Reviews, Medical treatment, Agentic Workflow, Employee welfare, Mental health, Mental Health Supports, incluido},
	pages = {1--6},
}

