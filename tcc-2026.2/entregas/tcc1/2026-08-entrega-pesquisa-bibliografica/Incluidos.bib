	keywords = {Large language models, Planning, Collaboration, Costs, Natural languages, 6G, 6G mobile communication, Application programming interfaces, Intent-based, Next generation networking, Operations support systems, Quality of service, Standardization, Language model, Multi agent systems, User interfaces, Natural language processing systems, Application programming interfaces (API), Hierarchical systems, 6g, Applications programming interfaces, Computer systems programming, High demand, Network management, Networking services, New applications, Operation support system, Quality-of-service, incluido},
	pages = {155--163},
