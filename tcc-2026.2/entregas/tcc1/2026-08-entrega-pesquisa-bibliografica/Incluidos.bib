	note = {Journal Abbreviation: Lect. Notes Comput. Sci.},
	keywords = {Multi-Agent Systems, Large language model, Large Language Models, Language model, Multiagent systems (MASs), Conversational agents, Model agents, Model-based OPC, Evaluation framework, Multi-stakeholder, Recommender Systems, Trade off, incluido},
	pages = {204--211},
	annote = {Export Date: 31 August 2026; Cited By: 5; Correspondence Address: M. Valentini; Politecnico di Bari, Bari, Italy; email: m.valentini7@phd.poliba.it; Conference name: 47th European Conference on Information Retrieval, ECIR 2025; Conference date: 6 April 2025 through 10 April 2025; Conference code: 330009},
