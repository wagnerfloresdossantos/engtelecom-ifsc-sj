	title = {An {Intelligent} {Multi}-{Turn} {Conversational} {Agent} for {Adaptive} {Quantum} {Computing} {Education} {Using} {Large} {Language} {Models} and {Quantum} {Circuit} {Simulation}},
	isbn = {2996-1815},
	doi = {10.1109/ESCI68015.2026.11493314},
	abstract = {Educational practices in quantum computing suffer from challenges relating to accessibility and personalization, and quantum computing education remains poorly adopted by learners and scholars. In this paper, we introduce QuantumTutor, an intelligent conversational agent that combines quantum circuit simulation and large-language models aimed at personalization for quantum computing education. The Groq LLM infrastructure, IBM Qiskit, and BeeAI multi-agent architecture, which includes conversation memory and 12-category query classification, provide the system with its foundational components. Extensive testing shows a coverage score of 0.7842 in relation to the benchmark content, 87.3\%. QuantumTutor automatically selects explanations depending on the learner’s prior knowledge, misconceptions, and their history of interaction to allow for a truly individualized learning trajectory. This system integrates real-time circuit simulation with natural language responses to bridge conceptual understanding and hands-on experimentation. A 12-category classifier ensures accurate routing of user queries to specialized agent modules for better response relevance and pedagogical effectiveness.},
