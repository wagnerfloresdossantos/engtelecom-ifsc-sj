	keywords = {Large language models, Modeling, Printing, Testing, Codes, Artificial intelligence, Application programming interfaces, Conferences, Documentation, Software, incluido},
	pages = {432--437},
}

@inproceedings{s.rishwanthAgenticAIConversational2025a,
	title = {Agentic {AI} for {Conversational} {Flight} {Reservation} {Systems}},
	doi = {10.1109/ICMNWC66779.2025.11354415},
	abstract = {The increasing demand for intelligent and adaptive conversational systems has driven research toward Agentic AI, which integrates reasoning, autonomy, and dynamic interaction. This paper presents an Agentic AI-based Flight Reservation System that automates flight search and booking through natural language dialogue. The system employs Large Language Models (LLMs) orchestrated using LangChain to interpret user queries, extract structured information, and interact with backend Java Spring Boot REST APIs connected to a MySQL database. Unlike rule-based chatbots, it uses contextual reasoning loops to handle incomplete or ambiguous inputs by autonomously seeking clarifications. Experimental evaluation across 100 booking scenarios achieved a 91\% task success rate, confirming its robustness and efficiency. The results demonstrate how integrating LLM reasoning with real-time APIs enhances decision-making, user experience, and transactional reliability. This work highlights Agentic AI’s potential to redefine human-machine interaction through self-directed, context-aware automation.},
	booktitle = {2025 5th {International} {Conference} on {Mobile} {Networks} and {Wireless} {Communications} ({ICMNWC})},
