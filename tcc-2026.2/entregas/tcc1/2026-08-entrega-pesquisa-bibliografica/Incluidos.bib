	keywords = {Intelligent agents, Multi agent systems, Information retrieval, Behavioral research, Customer support, Computational methods, Transactional analysis, Information management, Computation theory, Agent behavior, Analysis theory, Contextual information, Dynamic behaviors, Group dynamics, Model groups, Psychological research, Social research, incluido},
