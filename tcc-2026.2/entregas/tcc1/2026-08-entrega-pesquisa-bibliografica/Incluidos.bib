@inproceedings{stranoHEROGPTZeroShotConversational2024,
	title = {{HERO}-{GPT}: {Zero}-{Shot} {Conversational} {Assistance} in {Industrial} {Domains} {Exploiting} {Large} {Language} {Models}},
	isbn = {978-989758693-4 (ISBN)},
