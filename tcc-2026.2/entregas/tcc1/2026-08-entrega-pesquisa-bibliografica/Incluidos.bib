	title = {{SCIGENT}: {Multi}-agent for {End}-to-end {Question} {Answering} on {Scientific} {Knowledge} {Graph}},
	isbn = {26944804 (ISSN); 979-833158900-4 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105032691074?origin=resultslist},
	doi = {10.1109/KSE68178.2025.11309536},
	abstract = {Effective question answering over scientific literature demands up-to-date knowledge, a challenge exacerbated by the rapid growth of publications. Traditional Retrieval-Augmented Generation (RAG) methods, reliant on text-based retrieval, struggle with structured knowledge inherent in knowledge graphs. We introduce SCIGENT, a multi-agent platform for end-to-end question answering over scientific knowledge graphs, addressing the challenge of dynamic entity resolution and SPARQL query translation from raw user queries. Unlike traditional methods, SCIGENT operates in open-ended scenarios, resolving entities and relationships in real-time. Alongside this, we present SCIGENT-QA, a benchmark built on DBLP and ORKG knowledge graphs, to evaluate end-to-end question-answering systems. This benchmark provides a comprehensive testbed for assessing real-world applicability and robustness. Additionally, we release a full pipeline for constructing and continuously updating scientific knowledge graphs, ensuring the system remains current with emerging publications. This work advances knowledge-driven AI, enabling robust and scalable solutions for complex scientific queries. Empirical results demonstrate that SCIGENT, when used with popular large language models, achieves up to 65\% accuracy on the end-to-end evaluation of SCIGENT-QA, proving its practicality for real-world applications. © 2025 IEEE.},
	language = {English},
	booktitle = {Proc. {Int}. {Conf}. {Knowl}. {Syst}. {Eng}., {KSE}},
