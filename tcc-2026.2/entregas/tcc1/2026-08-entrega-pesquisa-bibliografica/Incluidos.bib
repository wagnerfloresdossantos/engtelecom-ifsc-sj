	keywords = {Semantics, Intelligent systems, Technological innovation, Software engineering, Protocols, Standards, Artificial intelligence, Adaptive Instructional System, Adaptive systems, Agentic Systems, AISC, IEEE Standards, Intelligent agents, Interoperability, LLM Agent Interface, incluido},
	pages = {1603--1609},
}

