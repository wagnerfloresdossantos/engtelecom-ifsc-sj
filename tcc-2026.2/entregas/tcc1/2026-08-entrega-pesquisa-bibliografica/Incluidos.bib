
@inproceedings{m.f.amriOptimizingLLMChatbot2026a,
	title = {Optimizing {LLM} {Chatbot} to {Human} {Handover} with {Multi}-{Agent} {AI} {Approach}},
	doi = {10.1109/ICADEIS71120.2026.11644567},
	abstract = {Chatbots have made customer journey easier by handling routine inquiries and identifying moments that need human intervention. Although Large Language Models (LLMs) and agentic workflows present a transformative opportunity for customer service, advancement in this domain is currently constrained by the lack of specialized public datasets required to evaluate and benchmark robust LLM-to-human handover protocols. To address this gap, the QiscusCS dataset is introduced as an evaluation benchmark. The QiscusCS dataset is a novel corpus of over 4,000 utterances from 100 customer service dialogues and manually annotated by domain experts. Using this new resource, this paper proposes and compares a Single-Agent and a Multi-Agent system for handling handovers. Our experiments show that the multi-Agent architectures achieve a Macro F1-Score of 0.6260 for Gemini 2.5 Flash and 0.6159 for GPT 4.1. On the other hand, the Single-Agent architecture shows inferior performance by achieving a Macro F1-Score of 0.3333 for Gemini 2.5 Flash and 0.5356 for GPT 4.1. Our results demonstrate the capability of multi-agent architectures for enhancing chatbot effectiveness. Moreover, this research also investigates the influence of model size and architectural strategy in optimizing customer service interactions.},
