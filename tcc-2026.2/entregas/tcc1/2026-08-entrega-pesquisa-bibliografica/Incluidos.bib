@inproceedings{k.-y.leeEnhancingTelecomOperation2025a,
	title = {Enhancing {Telecom} {Operation} {Support} {Systems} with {Multi}-{Agent} {Large} {Language} {Models}},
	doi = {10.1109/ICCAI66501.2025.00055},
	abstract = {This study investigates the integration of Large Language Models (LLMs) into Telecom Operation Support Systems (OSS) to enhance network management and user interaction. Adopting a Multi-Agent Architecture realizes significant advancements in AI-driven network management. LLMs enhance user interaction via natural language interfaces, reducing the need for specialized training and improving customer service through automation. This integration addresses OSS challenges by simplifying operations and providing intelligent insights for informed decision-making. The transition from a Single-Agent to a Multi-Agent Architecture enhances scalability and flexibility, allowing Chief and Specific Agents to collaborate in managing complex tasks efficiently. The Chief Agent oversees macro-level integration, while Specific Agents focus on domain-specific tasks and utilize tools for seamless data extraction and task execution. The architecture is designed to support parallel processing and adaptability, ensuring robust performance and scalability. Additionally, integrating large language models and agents enhances intuitive human-computer interaction, promoting accessibility and inclusivity. This comprehensive approach revolutionizes knowledge management and network administration by enabling proactive solutions and strategic decision-making. Integrating the strengths of LLMs and multi-agent systems, this framework provides a robust solution for modern telecommunications management, fostering innovation and efficiency in a rapidly evolving technological landscape. The contributions of this paper are manifold. Firstly, it introduces a novel Multi-Agent Architecture that leverages LLMs to transform OSS, significantly improving scalability and flexibility in network management. Secondly, it demonstrates how natural language interfaces can reduce the need for specialized training, thus enhancing user interaction and customer service. Thirdly, the study provides a detailed framework for the collaboration between Chief and Specific Agents, optimizing complex task management through intelligent insights and automation. Lastly, it highlights the role of LLMs in promoting accessibility and inclusivity, offering a strategic roadmap for future innovations in telecommunications management. These contributions collectively offer a groundbreaking approach to addressing the challenges faced by modern OSS, paving the way for more efficient and proactive network administration.},
	booktitle = {2025 11th {International} {Conference} on {Computing} and {Artificial} {Intelligence} ({ICCAI})},
	author = {{K. -Y. Lee} and {P. -A. Tseng} and {W. -C. Chen}},
	month = mar,
	year = {2025},
	note = {Journal Abbreviation: 2025 11th International Conference on Computing and Artificial Intelligence (ICCAI)},
	keywords = {Architecture, Computer architecture, Large Language Model, Large language models, Scalability, LLM, Large language model, Technological innovation, Autonomous agents, Multi-Agent, Training, Decision making, Telecommunications, Agents, Autonomous Networks, Gen AI, Human computer interaction, Knowledge management, Natural languages, Operation Support Systems, Sustainable development, Intelligent agents, Language model, Multi agent, Multi agent systems, Behavioral research, User interfaces, Multiagent architecture, Network management, Operation support system, Autonomous networks, Complex networks, Industrial management, Integration, Network architecture, Telecom, incluido},
	pages = {309--316},
	annote = {Export Date: 31 August 2026; Cited By: 1; Correspondence Address: K.-Y. Lee; Network Management Lab, Chunghwa Telecom Laboratories, Taiwan; email: kylee@cht.com.tw; Conference name: 11th International Conference on Computing and Artificial Intelligence, ICCAI 2025; Conference date: 28 March 2025 through 31 March 2025; Conference code: 211373},
