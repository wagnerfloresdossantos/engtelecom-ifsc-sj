@inproceedings{satijaFastWorkflowClosingPerformance2026,
	title = {{FastWorkflow}: {Closing} the {Performance} {Gap} between {Small} and {Frontier} {Language} {Models} for {Conversational} {Agents}},
	isbn = {979-840072415-2 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105046361009?origin=resultslist},
	doi = {10.1145/3786335.3813158},
	abstract = {Large language models are increasingly deployed in conversational agents that assist humans with complex, multi-step tasks, yet their deployment at scale is constrained by high inference costs, latency, and data privacy concerns. Small language models (SLMs) offer compelling operational advantages but exhibit systematic failure modes in agentic settings, particularly in conversational workflows: domains where tasks are solved interactively by a human and an LLM through structured tool invocation. Despite growing SLM deployment, these agentic failure modes remain poorly characterized and inadequately addressed. We present an empirically-grounded taxonomy categorizing SLM failures across five dimensions: natural language understanding failures, tool management failures, task decomposition and sequencing failures, agentic reasoning failures, and context management failures, and quantify their prevalence on the τ -bench benchmark. Guided by this taxonomy, we introduce fastWorkflow, a dual-mode agentic architectural framework implementing a cascaded NLU pipeline for intent detection and structured parameter extraction with validation, hierarchical context organization that reduces effective action space, explicit task planning with dependency-aware decomposition, and adaptive context management, among other targeted mitigations. On τ -bench, GPT-OSS-20B augmented with fastWorkflow achieves 83.47\% Pass{\textasciicircum}1 on the Retail domain and 78\% on Airline, surpassing all frontier models evaluated on τ -bench leaderboard including Claude Sonnet 4 (80.5\% Retail, 60.0\% Airline) and Claude Opus 4.1 (82.4\% Retail, 56.0\% Airline), while operating at ∼22 × lower inference cost. Even Mistral-7B-Instruct with fastWorkflow matches Claude Sonnet 4 on Airline at 60\%. Ablation studies confirm that the cascaded NLU pipeline is the most impactful component, with its removal causing performance collapses of 58 points on Retail and 68 points on Airline. Our findings demonstrate that architectural separation of concerns, offloading error-prone operations to structured subsystems while preserving LLM flexibility for planning and recovery, can close the performance gap between small and frontier models in conversational workflow tasks, shifting the cost-performance Pareto frontier for production deployment in domains involving multi-turn, tool-augmented human-LLM collaboration.  © 2026 Copyright held by the owner/author(s).},
	language = {English},
	booktitle = {Proc. {ACM} {Conf}. {AI} {Agentic} {Syst}., {CAIS}},
	publisher = {Association for Computing Machinery, Inc},
	author = {Satija, S. and Bhatt, A. and Jani, P. and Rawal, D.},
	year = {2026},
	note = {Journal Abbreviation: Proc. ACM Conf. AI Agentic Syst., CAIS},
	keywords = {Costs, Data privacy, Benchmarking, Conversational Agents, Language model, Multi agent systems, Conversational agents, Air transportation, Conversational workflow, Extraction, Failure (mechanical), Failure modes, Failure taxonomy, Failure Taxonomy, Management failures, Multisteps, Natural language understanding, Natural Language Understanding, Performance gaps, Small language model, Small Language Models, Taxonomies, Tool use, Tool Use, incluido},
	pages = {161--180},
	annote = {Export Date: 31 August 2026; Cited By: 0; Correspondence Address: D. Rawal; Radiant Logic, San Rafael, United States; email: drawal@radiantlogic.com; Conference name: ACM Conference on AI and Agentic Systems, CAIS 2026; Conference date: 26 May 2026 through 29 May 2026; Conference code: 226213},
}

