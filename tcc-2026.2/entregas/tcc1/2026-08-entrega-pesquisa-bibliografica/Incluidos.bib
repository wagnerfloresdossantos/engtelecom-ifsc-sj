}

@article{v.vashishthaCOSMICLeaderDrivenContextOriented2026a,
	title = {{COSMIC}: {Leader}-{Driven} {Context}-{Oriented} {Collaboration} {Between} {Agents}},
	volume = {13},
	issn = {2329-924X},
	doi = {10.1109/TCSS.2026.3661839},
	abstract = {We present COSMIC, a leader-driven multiagent coordination framework that extends the AutoGen GroupChat paradigm to support more stable and context-consistent collaboration among large language model (LLM) agents. COSMIC introduces: 1) a leader agent that decomposes tasks and issues an explicit termination decision; 2) a shared rolling memory buffer that synchronizes recent context across agents; and 3) a speaker selector agent (SSA) that enforces structured turn-taking and mitigates self-invocation and speaker imbalance. Across six coordination-intensive tasks, COSMIC achieves 100\% validity under task-specific hard-constraint criteria. On the five tasks where baseline frameworks produced validated outputs, COSMIC improves composite scores by 20.2\%, 23.3\%, 27.7\%, 52.6\%, and 46.9\% over CrewAI Hierarchical, CrewAI Sequential, AutoGen, LangChain, and OpenAI Swarm, respectively. COSMIC reduces wall-clock time relative to CrewAI Hierarchical, CrewAI Sequential, AutoGen, and LangChain by 57.3\%, 50.8\%, 61.4\%, and 77.6\%, while incurring higher runtime than OpenAI Swarm due to richer coordination and memory overhead. On GSM8K, COSMIC attains \$94{\textbackslash}pm 1\$\% accuracy, exceeding the sparse multiagent debate (MAD) configuration reported in a Google Research publication. Empirically, performance peaks around five agents, reflecting a trade-off between diversity and coordination overhead.},
	number = {3},
	journal = {IEEE Transactions on Computational Social Systems},
	author = {{V. Vashishtha} and {S. Pandey} and {Y. R. Singh} and {A. Bahga} and {V. K. Madisetti}},
	month = jun,
	year = {2026},
	keywords = {Chatbots, Multi-agent systems, Oral communication, Cognition, Collaboration, AutoGen, Artificial intelligence, Agent communication, collaborative AI, Context awareness, History, leader-driven termination, Memory, multiagent coordination, shared memory, Synchronization, incluido},
	pages = {3262--3287},
}

