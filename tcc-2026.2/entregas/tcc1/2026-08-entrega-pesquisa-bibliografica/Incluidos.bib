@inproceedings{a.inbavalliARTIAutomatedRTI2026a,
	title = {{ARTI}: {Automated} {RTI} {Framework} {Using} {Reasoning}- {Enhanced} {LLMs} and {Distributed} {RAG} for {Indian} {E}-{Governance}},
	doi = {10.1109/ICMSCI67830.2026.11469560},
	abstract = {The rise of Right-to-Information requests in India has put a lot of pressure on the Public Information Officers, which frequently leads to delays and inconsistencies and also creates a very high administrative burden. This paper presents ARTI-an automated RTI processing architecture that integrates reasoningenhanced large language model with distributed RetrievalAugmented Generation across departmental data silos. In addition, the system is designed with an ethics-aware query validation module, multi-intent decomposition, department-level hybrid retrieval, and a structured human-in-the-loop approval layer. We fine-tune DeepSeek-R1-Distill-Qwen-14B to enhance domain alignment and reduce hallucinations, thus enabling more accurate legal reasoning, better institutional routing, and context specific drafting of official responses. The proposed framework maintains institutional control in that no draft is sent to citizens without explicit PIO validation, but preserves transparency and auditability of the pipeline. Experimental evidence through controlled simulations demonstrates significant reduction in drafting time and better compliance with the statutory guidelines of the RTI Act. ARTI shows that LLM reasoning can be combined with agency-level RAG modules and human oversight to establish a scalable and accountable governance automation system.},
	booktitle = {2026 {Second} {International} {Conference} on {Multi}-{Agent} {Systems} for {Collaborative} {Intelligence} ({ICMSCI})},
	author = {{A. Inbavalli} and {C. Shriram} and {M. Subhashini} and {S. Nithyabharathi} and {K. Kalaiselvi} and {M. Thamizhmani}},
	month = mar,
