	title = {Multilingual {Conversational} {Artificial} {Intelligence} {Agent}},
	isbn = {979-833153244-4 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105031083813?origin=resultslist},
	doi = {10.1109/ICCBE65177.2025.11255778},
	abstract = {This study aims to construct a system capable of analyzing sentiment and extracting information from textual and audio data for customer service and multilingual communication management. The developed system integrates advanced artificial intelligence (AI) technologies, including large language models (LLMs) and audio processing frameworks, to detect sentiment trends (e.g., anger, sadness) for the interpretation of emotional dynamics. The system visualizes the trajectory of sentiment of conversations using dynamic graphical representations to identify patterns and changes in emotional tone. To enhance usability and accessibility, the system is implemented as a multilingual conversational AI agent and processes inputs across multiple languages. It supports real-time translation, sentiment detection, and interactive analysis, thereby accommodating a broad spectrum of linguistic and cultural contexts. The framework of the system leverages state-of-the-art natural language processing and audio analysis techniques to extract and interpret relevant data. The system's reliability and robustness are evaluated through rigorous evaluation criteria, including accuracy, adaptability to diverse languages, and real-time processing efficiency. The system enables a highly interactive, accurate, and adaptable platform for multilingual conversational analysis. By integrating sentiment analysis with real-time multilingual processing, the system enables artificial intelligence and human-computer interaction, with applications spanning various industries. © 2025 IEEE.},
