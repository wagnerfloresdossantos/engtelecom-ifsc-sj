@inproceedings{picoMultiAgentArchitectureEmotion2026,
	title = {A {Multi}-{Agent} {Architecture} for {Emotion} {Generation} and {Regulation} in {Conversational} {Agents}: {An} {Inside}-{Out} {Approach}},
	volume = {1},
	isbn = {21843589 (ISSN); 978-989758796-2 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105035584878?origin=resultslist},
	doi = {10.5220/0014652500004052},
	abstract = {This paper proposes a multi-agent systems based on large language models (LLMs) to simulate emotional processes. We present EMAD, an architecture designed to model both the generation and regulation of emotions, explicitly grounded in the theories of Paul Ekman and James J. Gross. The proposal uses a set of heterogeneous and specialized agents that collaborate to simulate different components of emotional processing. The core of the system consists of a set of emotional agents, each one specialized in interpreting information from the evaluative framework characteristic of one of the basic emotions described by Ekman. These agents are responsible for the attention and evaluation phases and cooperate to interpret information through a weighted voting mechanism. This mechanism reproduces Ekman’s refractory period: the relative influence of each agent is dynamically adjusted according to the current emotional state, so that the dominant emotion biases perception and cognitive evaluation as in Ekman’s theory . The process also includes a supervisory meta-agent, responsible for monitoring the overall state of the system. This meta-agent can activate regulatory agents capable of intervening in the attention process or in cognitive evaluation, thus modulating emotional dynamics. Through this approach, the system implements a form of emotional self-regulation inspired by Gross’s framework. © 2026 by SCITEPRESS-Science and Technology Publications, Lda.},
	language = {English},
	booktitle = {Int. {Conf}. {Agent}. {Artif}. {Intell}.},
	publisher = {Science and Technology Publications, Lda},
	author = {Pico, A. and Taverner, J. and Vivancos, E. and Garcia-Fornes, A. and Botti, V.},
	editor = {{Rocha A.P.} and {Wahde M.} and {van den Herik H.J.}},
	year = {2026},
	note = {Journal Abbreviation: Int. Conf. Agent. Artif. Intell.},
	keywords = {Multi-Agent Systems, Large Language Models, Conversational Agents, Affective Computing, Computational Psychology, Emotion Regulation, incluido},
	pages = {910--921},
	annote = {Export Date: 31 August 2026; Cited By: 0; Conference name: 18th International Conference on Agents and Artificial Intelligence, ICAART 2026; Conference date: 5 March 2026 through 8 March 2026; Conference code: 349319},
}

@inproceedings{mishraMultiAgentLLMPlatform2026,
	title = {A {Multi}-{Agent} {LLM} {Platform} for {Integrated} {Healthcare} {Services} with {Multi}-{Modal} {Data} {Analysis}},
	volume = {282},
	isbn = {18770509 (ISSN)},
	url = {https://www.scopus.com/pages/publications/105045593592?origin=resultslist},
	doi = {10.1016/j.procs.2026.05.177},
	abstract = {Healthcare accessibility remains a critical global challenge, with patients facing long waiting times, high consultation fees, and limited access to specialists. Early specialist consultation is limited in major disciplines such as primary or emergency care, neonatology, pediatric neurology, neuroradiology, clinical neurophysiology, and rehabilitation, bringing delays for conditions such as Hypoxic Ischemic Encephalopathy (HIE). This study encourages an AI healthcare professional to offer quick triage and uncertainty sensitive decision assistance to accelerate specialist evaluation. This paper presents the AI Health Consultant, a novel comprehensive healthcare platform based on a multi agent system utilizing a large language model (LLM) that integrates six core medical services such as medical chatbot, doctor appointment booking, EHR summarisation, X-ray analysis, nutrition advisory and multispecialty diagnosis. The uniqueness of our approach lies in the concurrent multispecialist consultation system using ThreadPoolExecutor, an agent based architecture with specialized medical domain agents, and multimodal AI processing capabilities combining text, image, and document analysis. Our platform leverages LangChain orchestration, the OpenAI API, and the Google Gemini API for vision language processing, creating an integrated healthcare ecosystem. The system demonstrates superior performance in medical triage efficiency, reducing consultation time compared to traditional methods, while maintaining diagnostic precision comparable to specialist consultations. Performance evaluation shows 92\% user satisfaction, 85\% diagnostic precision in six medical domains, and 3.2-second average response time for complex multispecialist queries. Unlike existing standalone medical AI tools, our platform provides comprehensive healthcare services in a unified interface with concurrent processing in real time, making it a significant advancement in AI-powered healthcare delivery. © 2026 The Authors.},
	language = {English},
	booktitle = {Procedia {Comput}. {Sci}.},
	publisher = {Elsevier B.V.},
	author = {Mishra, N. and Nived, R. and Nishanth, M. and Surendran, S. and Gargi, S.},
	editor = {{Singh P.K.}},
