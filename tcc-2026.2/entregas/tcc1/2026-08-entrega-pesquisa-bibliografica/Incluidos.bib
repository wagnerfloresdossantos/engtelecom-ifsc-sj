	pages = {1--9},
}

@inproceedings{f.sacconeDesignImplementationMultiAgent2025a,
	title = {Design and {Implementation} of a {Multi}-{Agent} {Threat} {Intelligence} {Assistant} {Based} on {Generative} {AI}},
	isbn = {2573-2978},
	doi = {10.1109/BigData66926.2025.11400902},
	abstract = {Cyber threat intelligence programs are designed to support the daily activities of cybersecurity analysts. However, most of the existing tools are unable to provide accurate information. To fill this gap and provide analysts with verified data, we propose an interactive assistant leveraging generative AI techniques and large language models (LLMs) to identify and categorize information related to threat actors based on open-source intelligence (OSINT). Users can interact with the assistant through a simple chat interface, asking questions in natural language. Based on the user's question, the assistant (i) queries a large knowledge base containing information about numerous threat actors collected from multiple OSINT sources and (ii) processes the response to make it comprehensible to the end user. The assistant, enabled with LLM capabilities, can also be used to generate summaries from cybersecurity research reports or extract specific information from them. A preliminary evaluation, conducted with experts in the field, demonstrates the effectiveness of the proposed assistant in supporting the daily activities of cyber threat analysts.},
	booktitle = {2025 {IEEE} {International} {Conference} on {Big} {Data} ({BigData})},
	author = {{F. Saccone} and {A. Manzi} and {A. Di Sorbo} and {E. Costante} and {C. A. Visaggio}},
