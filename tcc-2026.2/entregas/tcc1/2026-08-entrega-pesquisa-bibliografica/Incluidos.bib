	note = {Journal Abbreviation: 2025 55th Annual IEEE/IFIP International Conference on Dependable Systems and Networks - Supplemental Volume (DSN-S)},
	keywords = {Multi-agent systems, LLM, Adaptation models, Codes, Security, Manuals, Degradation, Genetic algorithms, Particle separators, Prompt Injection, incluido},
	pages = {22--28},
}

