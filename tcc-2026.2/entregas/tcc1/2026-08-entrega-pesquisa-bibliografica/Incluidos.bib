@inproceedings{malikMultiAgentFrameworkAdaptive2026,
	title = {Multi-{Agent} {Framework} for {Adaptive} {Social}-{Emotional} {Learning} in {Children}’s {Digital} {Communication}},
	isbn = {979-840071985-1 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105035385861?origin=resultslist},
	doi = {10.1145/3742414.3794776},
	abstract = {In today’s digital society, children are increasingly exposed to online communication environments at an early age, often before they have developed the social and emotional skills required to manage misunderstandings, conficts, and emotionally charged interactions. We present Lilo, an interactive multi-agent conversational system designed to help children aged 8 to 11 practice safe, empathetic, and refective digital communication. Lilo ofers scenario-based chat simulations that resemble familiar messaging platforms, allowing children to experiment with communication strategies in a protected environment without real-world social consequences. The system integrates adaptive conversational agents with a structured intervention mechanism based on the Stop–Think–Act pedagogical framework. This demo paper presents the system design, interaction model, and educational rationale underlying Lilo, and demonstrates how large language models can be leveraged to support social and emotional learning through guided digital interaction. © 2026 Copyright held by the owner/author(s).},
