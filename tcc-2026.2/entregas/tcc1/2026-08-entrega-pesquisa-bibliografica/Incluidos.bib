	title = {Neethi {AI}: {An} {AI}-{Powered} {Multi}-{Agent} {System} for {Indian} {Legal} {Advisory}},
	doi = {10.1109/ICIICE69672.2026.11565303},
	abstract = {Access to legal knowledge and justice in India remains a significant barrier for ordinary citizens. Legal language is complex, lawyers are expensive, and government legal aid infrastructure is underfunded. This paper presents Neethi AI, a production-grade, AI-powered judiciary chatbot specifically designed for the Indian legal ecosystem. The system leverages a multi-agent architecture built on CrewAI, Hybrid Retrieval-Augmented Generation (RAG) using BGE-M3 dense and BM25 sparse embeddings indexed in Qdrant, and a role-aware response pipeline that adapts output for citizens, lawyers, legal advisors, and police personnel. A key innovation is the hallucination-free citation verification mechanism that cross-checks every statutory reference before delivery, and a zero-LLM query router that reduces latency for common lookup queries. The system indexes 12 major Indian statutes including the new Bharatiya Sanhitas (BNS, BNSS, BSA) that replaced colonial-era codes on 1 July 2024, along with 37,965 Supreme Court judgment chunks. An automated legal document drafting module generates bail applications, FIR drafts, legal notices, and consumer complaints. Voice-based interaction in 12 Indian languages using Sarvam AI enables access for non-literate users. Evaluation results demonstrate high retrieval precision, sub-300ms latency for direct queries, and strong user satisfaction across all user roles.},
	booktitle = {2026 {International} {Conference} on {Integrated} {Intelligence} and {Cognitive} {Engineering} ({ICIICE})},
