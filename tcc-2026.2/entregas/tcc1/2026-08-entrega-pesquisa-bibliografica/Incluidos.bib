@article{zhouLongitudinalBehavioralChange2026,
	title = {Longitudinal behavioral change coaching with multi {LLM} agents: {Multi}-scale summaries and automated dialogue steering},
	volume = {41},
	issn = {23526483 (ISSN)},
	url = {https://www.scopus.com/pages/publications/105044854885?origin=resultslist},
	doi = {10.1016/j.smhl.2026.100694},
	abstract = {Longitudinal behavioral change coaching requires sustained, relationship-dependent support across weeks, yet most LLM-based conversational agents are optimized for short, loosely structured interactions. In extended use, such agents frequently lose track of evolving goals and unresolved barriers, resulting in repetitive questioning and degraded counseling structure. We present a multi-LLM system that structures longitudinal coaching as a controlled process grounded in evidence-based behavioral strategies. This system consists of multiple LLM-based agents with defined roles. A summary agent maintains a persistent coaching state aligned with SMART goal principles. At the same time, an automated signal generator agent converts this state with recent chat history into compact steering instructions injected into a dialogue agent’s prompt for response. By separating stable counseling principles from dynamic session guidance, the system enables proactive agenda management without reliance on unbounded conversational history.We implement a web-based prototype featuring a multi-page coaching interface and a database. We validate the proposed system with this prototype in a multi-session, multi-user study, comparing against prompt-only and memory-based baseline conditions. The results suggest that the proposed multi-agent system consistently achieves high-quality longitudinal coaching performance across multiple dimensions. More broadly, our architecture offers a reusable design pattern in supporting sustained coaching trajectories. It provides a practical foundation for future digital health coaching systems that require reliable continuity, goal tracking, and follow-up. © 2026 Published by Elsevier Inc.},
	language = {English},
	journal = {Smart Health},
	publisher = {Elsevier B.V.},
	author = {Zhou, H. and Skalski-Fouts, Z. and Nguyen, L. and Rivera, C. and Spring, B. and Miao, H. and Zhang, X.},
	year = {2026},
	keywords = {Large Language Model, large language model, Article, behavior change, Behavioral change coaching, behavioral intervention, coaching, Conversational agent, digital health, follow up, Long-term tracking, Motivational interviewing, web-based intervention, incluido},
	annote = {Export Date: 31 August 2026; Cited By: 0; Correspondence Address: X. Zhang; Department of Computer Science, Florida State University, Tallahassee, United States; email: xzhang14@fsu.edu},
}

@inproceedings{patelkhanaZeroTrustGatewayProtocol2026,
	title = {Zero-{Trust} {Gateway} {Protocol} for {Multi}-{Tenant} {AI} {Agents}},
	isbn = {979-833154568-0 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105044276872?origin=resultslist},
	doi = {10.1109/AIIoT68874.2026.11569638},
	abstract = {Today’s Agentic AI environments have shifted from direct large language model invocations to orchestrated, autonomous micro-agents such as sales automation, HR management, and customer service that interpret user intent and execute actions independently. Multiple web clients mediate user access to these agents, raising a critical question: how to enforce fine-grained user-to-agent-to-skill policy validation while decoupling web clients from agents. This paper proposes a Zero-Trust Gateway Protocol, informed by NIST SP 800-207 [1] and SP 800-207A [2], that intercepts every request at /tenant/\{tenantId\}/agent/\{agentId\}, validates tenant-aware user-to-agent access policies, and performs OAuth 2.0 Token Exchange (RFC 8693) [3] to issue short-lived, agent-scoped tokens with skill-level scope restrictions. The gateway authenticates to the OIDC provider as a confidential client and exchanges the web client’s access token (sub=user, aud=webclientAppName) for an agent-scoped token (sub=user, aud=agentId, scope=permitted\_skills), optionally including tenant\_id=tenantId as a custom claim when supported by the IdP. This creates a two-dimensional access control model that restricts both which agent and what capabilities each user may invoke. Implemented as a gateway plugin integrated with an OIDC provider, this prototype eliminates direct web client-to-agent trust relationships, enforces tenant-aware user-to-agent access policies (expressible as RBAC or ABAC rules) at a purpose-built gateway enforcement point, and minimizes token exposure through scoped delegation. Evaluation against eleven threat categories including over-privileged tokens, lateral agent access, scope escalation, and tenant boundary violations demonstrates the protocol’s security properties, and a gateway compromise analysis identifies residual risks with layered hardening measures. © 2026 IEEE.},
	language = {English},
	booktitle = {{IEEE} {World} {AI} {IoT} {Congr}., {AIIoT}},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Patelkhana, V.P.},
	year = {2026},
	note = {Journal Abbreviation: IEEE World AI IoT Congr., AIIoT},
	keywords = {Autonomous agents, Agents, Intelligent agents, Language model, Multi agent systems, Access control models, Access policies, Critical questions, Customer-service, Gateway protocols, Gateways (computer networks), Management service, Micro-agents, Multi tenants, Network security, Users access, Web clients, incluido},
	pages = {605--610},
	annote = {Export Date: 31 August 2026; Cited By: 0; Correspondence Address: V.P. Patelkhana; United States; email: phani.patelkhana@gmail.com; Conference name: 2026 IEEE World AI IoT Congress, AIIoT 2026; Conference date: 20 May 2026 through 22 May 2026; Conference code: 225252},
}

@inproceedings{arslanApplicationLevelMultiagent2026,
	title = {Application level multi-agent methodology for chatbots},
	volume = {280},
	isbn = {18770509 (ISSN)},
	url = {https://www.scopus.com/pages/publications/105042470513?origin=resultslist},
	doi = {10.1016/j.procs.2026.04.101},
	abstract = {Multi-agent LLM architectures have emerged as an effective approach for handling complex customer support scenarios through task decomposition across specialized agents. This paper presents a multi-agent chatbot architecture designed to improve customer experience and operational efficiency in telecommunications industry. The proposed system employs a Master Expert that performs intent Classification to route queries to eleven specialized domain experts, each maintaining domain-specific knowledge bases and implementing pre-defined conversational flows for multi-step transactional operations. The system uses Retrieval-Augmented Generation (RAG) for semantic search and integrates with backend APIs for real-time data access, supporting dual-channel deployment across web and mobile platforms. Experimental results from a two-month production deployment at sTurknet demonstrate a 12-fold increase in digital assistant engagement, a 51\% improvement in customer satisfaction (DDA score from 1.62 to 2.45), and reduced live chat escalations, validating the architecture's effectiveness for customer service automation while maintaining service quality at scale.  © 2026 The Authors.},
