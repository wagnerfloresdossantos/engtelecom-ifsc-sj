@inproceedings{c.moncadaLargeLanguageModels2025a,
  title = {Large {{Language Models}} and {{Multi-Agent Systems}} for {{Customer Support Ticket Automation}}},
  booktitle = {2025 {{IEEE Ninth Ecuador Technical Chapters Meeting}} ({{ETCM}})},
  author = {Moncada, C. and Lemus-Cárdenas, L. and Crespo, F. and Astudillo-León, J. P.},
  year = 2025,
  month = oct,
  pages = {1--6},
  doi = {10.1109/ETCM67548.2025.11304425},
  abstract = {Customer service operations increasingly struggle to handle the rising volume and complexity of support tickets, exposing the limitations of traditional rule-based workflows and static machine learning models that often lack contextual adaptability. This paper presents a modular architecture that integrates multi-agent systems orchestrated by large language models (LLMs), specifically G PT-4-mini, implemented through the CrewAI framework. The proposed system leverages specialized agents for data ingestion, ticket classification into categories such as incident, request, change, and problem, and the generation of contextually appropriate responses. Experimental evaluations conducted on a dataset of technical support tickets demonstrate an average classification accuracy of 85\% and a mean cosine similarity of \$\textbackslash mathbf\textbraceleft 7 5 \textbackslash\%\textbraceright\$---capturing semantic alignment beyond lexical overlap. These results highlight the effectiveness of combining LLM-driven reasoning with multi-agent coordination to automate customer support workflows, offering a scalable foundation for deploying intelligent systems across diverse operational environments.},
  keywords = {Automation,Computational linguistics,Crewai,CrewAI,Customer service operations,Customer services,Customer support,Customer support automation,Data ingestion,Diversity reception,incluido,Intelligent agents,Intelligent systems,Language model,Large language model,Large language models,Learning systems,Machine learning,Model agents,Multi agent systems,Multi-agent systems,Multiagent systems (MASs),Sales,Semantic similarity,Semantics,Solid modeling,Work-flows},
  file = {/home/wagner/Zotero/storage/HNU5SISY/C. Moncada et al. - 2025 - Large Language Models and Multi-Agent Systems for Customer Support Ticket Automation.pdf}
}
@inproceedings{k.-y.leeEnhancingTelecomOperation2025a,
  title = {Enhancing {{Telecom Operation Support Systems}} with {{Multi-Agent Large Language Models}}},
  booktitle = {2025 11th {{International Conference}} on {{Computing}} and {{Artificial Intelligence}} ({{ICCAI}})},
  author = {Lee, K.-Y. and Tseng, P.-A. and Chen, W.-C.},
  year = 2025,
  month = mar,
  pages = {309--316},
  doi = {10.1109/ICCAI66501.2025.00055},
  abstract = {This study investigates the integration of Large Language Models (LLMs) into Telecom Operation Support Systems (OSS) to enhance network management and user interaction. Adopting a Multi-Agent Architecture realizes significant advancements in AI-driven network management. LLMs enhance user interaction via natural language interfaces, reducing the need for specialized training and improving customer service through automation. This integration addresses OSS challenges by simplifying operations and providing intelligent insights for informed decision-making. The transition from a Single-Agent to a Multi-Agent Architecture enhances scalability and flexibility, allowing Chief and Specific Agents to collaborate in managing complex tasks efficiently. The Chief Agent oversees macro-level integration, while Specific Agents focus on domain-specific tasks and utilize tools for seamless data extraction and task execution. The architecture is designed to support parallel processing and adaptability, ensuring robust performance and scalability. Additionally, integrating large language models and agents enhances intuitive human-computer interaction, promoting accessibility and inclusivity. This comprehensive approach revolutionizes knowledge management and network administration by enabling proactive solutions and strategic decision-making. Integrating the strengths of LLMs and multi-agent systems, this framework provides a robust solution for modern telecommunications management, fostering innovation and efficiency in a rapidly evolving technological landscape. The contributions of this paper are manifold. Firstly, it introduces a novel Multi-Agent Architecture that leverages LLMs to transform OSS, significantly improving scalability and flexibility in network management. Secondly, it demonstrates how natural language interfaces can reduce the need for specialized training, thus enhancing user interaction and customer service. Thirdly, the study provides a detailed framework for the collaboration between Chief and Specific Agents, optimizing complex task management through intelligent insights and automation. Lastly, it highlights the role of LLMs in promoting accessibility and inclusivity, offering a strategic roadmap for future innovations in telecommunications management. These contributions collectively offer a groundbreaking approach to addressing the challenges faced by modern OSS, paving the way for more efficient and proactive network administration.},
  keywords = {Agents,Architecture,Autonomous agents,Autonomous networks,Autonomous Networks,Behavioral research,Complex networks,Computer architecture,Decision making,Gen AI,Human computer interaction,incluido,Industrial management,Integration,Intelligent agents,Knowledge management,Language model,Large language model,Large Language Model,Large language models,LLM,Multi agent,Multi agent systems,Multi-Agent,Multiagent architecture,Natural languages,Network architecture,Network management,Operation support system,Operation Support Systems,Scalability,Sustainable development,Technological innovation,Telecom,Telecommunications,Training,User interfaces},
  file = {/home/wagner/Zotero/storage/ZFBUBQ8S/K. -Y. Lee et al. - 2025 - Enhancing Telecom Operation Support Systems with Multi-Agent Large Language Models.pdf}
}

